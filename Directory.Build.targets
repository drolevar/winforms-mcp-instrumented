<Project>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(RepositoryRoot)LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <Target Name="ValidateInstrumentationBuildSwitch" BeforeTargets="PrepareForBuild"
          Condition="'$(IsInstrumentationConsumer)' == 'true'">
    <Error Condition="'$(EnableWinFormsMcpInstrumentation)' != 'true' and '$(EnableWinFormsMcpInstrumentation)' != 'false'"
           Text="EnableWinFormsMcpInstrumentation must be true or false." />
  </Target>
</Project>
